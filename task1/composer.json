{
    "name": "se1y4/count-summator",
    "description": "Сумма чисел из всех файлов count в дереве директорий",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "mikey179/vfsstream": "^1.6.11",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Se1y4\\CountSum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Se1y4\\CountSum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
